# Console backend the MCP server connects to.
CONSOLE_BASE_URL=https://localhost:8181
CONSOLE_USERNAME=
CONSOLE_PASSWORD=
# Console ships a self-signed TLS cert by default; set to false in production.
CONSOLE_INSECURE_SKIP_VERIFY=true
CONSOLE_REQUEST_TIMEOUT_SECONDS=30

# SSE server bind address and advertised base URL.
MCP_ADDR=:8080
MCP_BASE_URL=http://localhost:8080
